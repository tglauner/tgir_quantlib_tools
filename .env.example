FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_LOGIN_USERNAME=demo
APP_LOGIN_PASSWORD=replace-with-a-strong-password
# APP_LOGIN_PASSWORD_HASH=pbkdf2:sha256:...
FLASK_DEBUG=1
PORT=5050

# Local development sends analytics to the local collector by default.
# Production (FLASK_DEBUG=0) defaults to https://tglauner.com/collect.
ANALYTICS_ENABLED=1
ANALYTICS_APP_ID=quant
# ANALYTICS_COLLECTOR_URL=http://127.0.0.1:9000/collect
# ANALYTICS_SCRIPT_URL=https://tglauner.com/visitor_analytics/tracking/tracking.js
