% Set themes
% Very sober theme with logo
\usetheme{default}
\useinnertheme{rounded} % This is my preferred theme after testing all
\setbeamertemplate{headline}{} % Keep the canvas clear apart from the logo overlay
\setbeamertemplate{navigation symbols}{} % Remove the navigation symbols
\setbeamercovered{invisible}
\beamerdefaultoverlayspecification{} % Keep template branding stable on every rendered page

% Bring structure due to section outline every time
\AtBeginSection[]{
  \setbeamercovered{transparent}
  %\begin{frame}<beamer>{Outline} % Not used as it does not show in handout mode and creates missing slides
  \begin{frame}{Outline}
    \tableofcontents[currentsection]
  \end{frame}
  \setbeamercovered{invisible}
}

% Popup table of contents to pop up at the beginning of each subsection
\AtBeginSubsection[]
{
  \setbeamercovered{transparent}
  %\begin{frame}<beamer>{Outline} % Not used as it does not show in handout mode and creates missing slides
  \begin{frame}{Outline}
    \tgirlogo
    \tableofcontents[currentsection,currentsubsection]
  \end{frame}
  \setbeamercovered{invisible}
}

%From gpt-3.5
\newcommand{\tgirfooterdate}{}
\AtBeginDocument{%
  \hypersetup{pdfauthor={Tim Glauner, TG Investments and Research, LLC}}%
  \global\let\tgirfooterdate\insertshortdate
}
\AddToHook{begindocument/end}{\hypersetup{pdfauthor={Tim Glauner, TG Investments and Research, LLC}}}
\defbeamertemplate*{footline}{my metropolis theme}{
    \begin{beamercolorbox}[wd=\paperwidth,ht=3ex,dp=1ex,leftskip=0.4cm,rightskip=0.4cm]{author in head/foot}
      \scriptsize\tgirfooterdate \hfill \insertshorttitle \hfill \texttt{glaunertim@gmail.com} \hfill \insertsection \hfill \insertframenumber
    \end{beamercolorbox}
}
\setbeamertemplate{footline}[my metropolis theme]

