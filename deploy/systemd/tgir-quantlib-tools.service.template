[Unit]
Description=TGIR QuantLib Tools Gunicorn Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/tgir_quantlib_tools
EnvironmentFile=/var/www/html/tgir_quantlib_tools/.env
Environment=HOME=/var/www/html/tgir_quantlib_tools
ExecStart=/var/www/html/tgir_quantlib_tools/.venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8008 \
    --timeout 120 \
    wsgi:app
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
