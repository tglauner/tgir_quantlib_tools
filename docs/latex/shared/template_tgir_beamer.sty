% New frame that shows a blank screen as first item so students look at title
% Define a custom frame environment
\newenvironment{pause_frame}[1]
{
    \begin{frame}{#1}
    \pause % Ensure the first item doesn't show up immediately
}
{
    \end{frame}
}

