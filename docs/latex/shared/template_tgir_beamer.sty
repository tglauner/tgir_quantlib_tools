%% Add the logo to the title page template and frames
\newcommand{\tgirlogopath}{}
\newif\iftgirlogo
\tgirlogofalse
\newcommand{\TGIRSetLogo}[1]{\gdef\tgirlogopath{#1}\tgirlogotrue}
\newcommand{\tgirlogo}{%
  \iftgirlogo
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=north east,xshift=-0.2cm,yshift=-0.15cm] at (current page.north east)
        {\includegraphics[height=0.75cm]{\tgirlogopath}};
    \end{tikzpicture}%
  \fi
}
\setbeamertemplate{title page}{%
  \vfill
  \centering
  \usebeamercolor[fg]{titlegraphic}\inserttitlegraphic\par
  \usebeamertemplate*{title}\par
  \vskip0.25em%
  \usebeamertemplate*{subtitle}\par
  \vskip1em\par
  \usebeamertemplate*{author}\par
  \usebeamertemplate*{date}\par
  \usebeamertemplate*{institute}\par
}

% Render the logo after every frame, including section and subsection outlines.
\addtobeamertemplate{footline}{}{\tgirlogo}
